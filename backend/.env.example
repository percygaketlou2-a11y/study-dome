# Copy this file to .env and fill in real values before running the server.

# Local dev default shown; production should point at a real Postgres
# instance, e.g. postgresql://user:password@host:5432/dbname
# (also requires changing `provider = "sqlite"` to `"postgresql"` in
# prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Generate a strong random value for production, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret"

PORT=4000

# Whichever email registers with this address is automatically made an admin
ADMIN_EMAIL="you@example.com"

# Used to build absolute links in emails and DPO payment redirects.
# Set these to your real deployed URLs in production.
FRONTEND_URL="http://localhost:5173"
BACKEND_URL="http://localhost:4000"

# --- Email (Gmail via Nodemailer) ---
# Leave both blank to keep the current dev-mode behavior (links shown
# on-screen instead of emailed). Fill in to send real emails:
#   1. Turn on 2-Step Verification: myaccount.google.com/security
#   2. Create an App Password: myaccount.google.com/apppasswords
#   3. Paste that 16-character password below (not your normal Gmail password)
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_FROM="Study Dome <you@gmail.com>"

# --- Payment (DPO Pay) ---
# Leave both blank to keep the manual "test unlock" button on /upgrade.
# Get these from your DPO merchant account (https://www.dpogroup.com):
# CompanyToken and the ServiceType configured for this product/currency.
DPO_COMPANY_TOKEN=""
DPO_SERVICE_TYPE=""
# Set to "true" while testing against DPO's sandbox environment.
DPO_SANDBOX="true"
