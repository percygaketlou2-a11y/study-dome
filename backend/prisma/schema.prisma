// Study Dome database schema.
// Using SQLite for zero-config local dev; swap provider to "postgresql"
// and set DATABASE_URL to a Postgres connection string for production.
//
// Mirrors the six-table reference model (Curricula, Levels, Subjects, Topics,
// PastPapers, Quizzes/Questions/Options), translated to Prisma conventions
// (cuid ids, camelCase fields) to stay consistent with the rest of this schema.

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                   String          @id @default(cuid())
  name                 String
  email                String          @unique
  passwordHash         String
  isAdmin              Boolean         @default(false)
  plan                 String          @default("free") // "free" | "premium" - manually toggled for now; swap in a real payment provider by changing what writes this field
  emailVerified         Boolean         @default(false)
  verifyTokenHash       String?
  verifyTokenExpiresAt  DateTime?
  resetTokenHash        String?
  resetTokenExpiresAt   DateTime?
  passwordChangedAt     DateTime? // sessions issued before this moment are rejected
  selectedCurriculumId String?
  selectedCurriculum   Curriculum?     @relation(fields: [selectedCurriculumId], references: [id])
  termsAcceptedAt      DateTime?       // set at registration when the user accepts Terms & Privacy Policy - an audit trail of consent
  quizResults          QuizResult[]
  dailyActivity        DailyActivity[]
  paymentTransactions  PaymentTransaction[]
  createdAt            DateTime        @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

model PaymentTransaction {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    String    @default("dpo")
  transToken  String    @unique // DPO's TransToken for this checkout attempt
  amount      Int
  currency    String    @default("BWP")
  status      String    @default("pending") // "pending" | "paid" | "failed"
  createdAt   DateTime  @default(now())
  completedAt DateTime?
}

model DailyActivity {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   String // "YYYY-MM-DD", one row per user per active day

  @@unique([userId, date])
}

model Curriculum {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  levels      Level[]
  subjects    Subject[]
  users       User[]
}

model Level {
  id           String     @id @default(cuid())
  curriculumId String
  curriculum   Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  name         String     // "Junior", "AS-Level", "A2-Level", "HL", "SL"...

  @@unique([curriculumId, name])
}

model Subject {
  id           String      @id @default(cuid())
  curriculumId String
  curriculum   Curriculum  @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  subjectCode  String?     // e.g. "0580" for IGCSE Maths
  name         String
  category     String?     // "STEM" | "Humanities" | "Languages" | "Commercial" | ...
  notes        String?     // admin-authored study notes; read-only for students
  syllabusYear         Int?     // year of the examining body's syllabus the content is written against
  assessment           String?  // paper structure, as printed in the syllabus
  assessmentObjectives String?  // JSON array of assessment-objective codes
  topics       Topic[]
  quizzes      Quiz[]
  pastPapers   PastPaper[]
  videos       Video[]
  tutorials    Tutorial[]
  topicNotes   TopicNote[]
  structuredQuestions StructuredQuestion[]

  @@unique([curriculumId, name])
}

model Topic {
  id            String   @id @default(cuid())
  subjectId     String
  subject       Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title         String
  sequenceOrder Int      @default(0)
  key           String?  @unique // stable content-pack key, e.g. "CHEM-3.2"
  code          String?  // syllabus topic code, e.g. "3.2"
  unitCode      String?
  unitName      String?
  quizzes       Quiz[]
  objectives    Objective[]
  notes         TopicNote[]
  structuredQuestions StructuredQuestion[]
}

// A specific learning objective from the examining body's syllabus.
model Objective {
  id           String  @id @default(cuid())
  key          String  @unique // e.g. "CHEM-3.2-01"
  topicId      String
  topic        Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)
  syllabusCode String? // code as printed in the syllabus, e.g. "3.2.1.1"
  text         String
  order        Int     @default(0)
  notes        TopicNote[]          @relation("NoteObjectives")
  questions    Question[]           @relation("QuestionObjectives")
  structuredQuestions StructuredQuestion[] @relation("StructuredObjectives")
}

// A section of study notes for one topic. Written in a small Markdown subset.
// Students only see notes whose reviewStatus is "approved".
model TopicNote {
  id           String   @id @default(cuid())
  key          String   @unique
  subjectId    String
  subject      Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topicId      String
  topic        Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  heading      String
  bodyMarkdown String
  order        Int      @default(0)
  reviewStatus String   @default("not_reviewed") // "not_reviewed" | "approved" | "approve_with_edits" | "rejected"
  corrections  String?
  reviewerName String?
  reviewedAt   DateTime?
  objectives   Objective[] @relation("NoteObjectives")
}

// A multi-part, exam-style question with a mark scheme per part. Not
// auto-graded: students answer, then reveal the mark scheme to self-mark.
model StructuredQuestion {
  id         String   @id @default(cuid())
  key        String   @unique
  subjectId  String
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topicId    String
  topic      Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  paperStyle String?
  assessmentObjective String?
  totalMarks Int
  stem       String
  source     String?
  parts      StructuredPart[]
  objectives Objective[] @relation("StructuredObjectives")
}

model StructuredPart {
  id           String   @id @default(cuid())
  questionId   String
  question     StructuredQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label        String?  // part letter, e.g. "a"; absent on single-part questions
  prompt       String
  marks        Int
  markScheme   String
  order        Int      @default(0)
  reviewStatus String   @default("not_reviewed")
  corrections  String?
  reviewerName String?
  reviewedAt   DateTime?
}

model Quiz {
  id                String       @id @default(cuid())
  subjectId         String
  subject           Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topicId           String?
  topic             Topic?       @relation(fields: [topicId], references: [id], onDelete: SetNull)
  title             String
  timeLimitMinutes  Int?
  totalMarks        Int
  isPremium         Boolean      @default(false)
  questions         Question[]
  results           QuizResult[]
}

model Question {
  id           String   @id @default(cuid())
  quizId       String
  quiz         Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questionText String
  questionType String   @default("multiple_choice") // "multiple_choice" | "short_answer" | "true_false"
  explanation  String?
  marks        Int      @default(1)
  order        Int      @default(0)
  options      Option[]
  // Content-pack / review metadata. Existing and admin-authored questions
  // default to "approved"; imported drafts start as "not_reviewed" and stay
  // hidden from students until approved.
  key          String?  @unique
  reviewStatus String   @default("approved") // "not_reviewed" | "approved" | "approve_with_edits" | "rejected"
  suggestedCorrectOption String? // reviewer's "correct answer if different", as a letter A-D
  corrections  String?
  reviewerName String?
  reviewedAt   DateTime?
  difficulty   Int?
  assessmentObjective String?
  source       String?
  objectives   Objective[] @relation("QuestionObjectives")
}

model Option {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionText String
  isCorrect  Boolean  @default(false)
  order      Int      @default(0)
}

model QuizResult {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  quizId         String
  quiz           Quiz     @relation(fields: [quizId], references: [id])
  score          Int      // percentage, 0-100
  marksAwarded   Int
  totalMarks     Int
  completedAt    DateTime @default(now())
}

model PastPaper {
  id                String   @id @default(cuid())
  subjectId         String
  subject           Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  year              Int
  season            String?  // "May/June" | "Oct/Nov" | ...
  paperNumber       Int
  variant           Int      @default(1)
  title             String?
  fileUrl           String
  markingSchemeUrl  String?
  isPremium         Boolean  @default(false)
  createdAt         DateTime @default(now())
}

model Video {
  id        String   @id @default(cuid())
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title     String
  url       String   // admin-pasted YouTube/Vimeo link; embed URL is derived from this at read time
  isPremium Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Tutorial {
  id        String         @id @default(cuid())
  subjectId String
  subject   Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title     String
  isPremium Boolean        @default(false)
  createdAt DateTime       @default(now())
  steps     TutorialStep[]
}

model TutorialStep {
  id         String   @id @default(cuid())
  tutorialId String
  tutorial   Tutorial @relation(fields: [tutorialId], references: [id], onDelete: Cascade)
  order      Int      @default(0)
  text       String
  imageUrl   String?
  imageAlt   String?  // admin-written description of the image, for screen-reader alt text
}
