# Study Dome - production settings.
# Enter these as environment variables in your host's dashboard (do not commit a
# filled-in copy). See "Going live" in README.md.

NODE_ENV=production

# From your host's PostgreSQL service.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# 32+ random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it later signs every user out.
JWT_SECRET=

# Your public address, with https. The API shares it, so both are the same.
FRONTEND_URL=https://YOUR-DOMAIN
BACKEND_URL=https://YOUR-DOMAIN

# The owner account. Register with this address first; it becomes the admin.
ADMIN_EMAIL=you@example.com

# Folder on the host's persistent disk (uploaded past papers and images).
UPLOADS_DIR=/data/uploads

# 1 on nearly every host (one reverse proxy in front of the app).
TRUST_PROXY=1

# Email - REQUIRED. The server will not start without it. Use a dedicated Gmail
# account with 2-Step Verification on, and put its 16-letter App Password in
# EMAIL_PASS (myaccount.google.com/apppasswords). The normal password won't work.
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Study Dome <you@gmail.com>"
# Optional: use a different mail service instead of Gmail (Brevo, Mailgun, ...).
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587

# Payments (DPO Pay) - leave blank until you have a merchant account.
DPO_COMPANY_TOKEN=
DPO_SERVICE_TYPE=
DPO_SANDBOX=true
