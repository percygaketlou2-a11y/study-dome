# Copy this file to .env and fill in real values before running the server.

# Local dev default shown; production should point at a real Postgres
# instance, e.g. postgresql://user:password@host:5432/dbname
# (also requires changing `provider = "sqlite"` to `"postgresql"` in
# prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Generate a strong random value for production, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In production the server REFUSES TO START if this is missing, under 32
# characters, or still a placeholder. Changing it signs every user out.
JWT_SECRET="replace-with-a-long-random-secret"

PORT=4000

# Set to "production" when deployed. Turns off the manual Premium test-unlock
# endpoints and makes the startup checks above fatal.
# NODE_ENV=production

# The OWNER: whichever account registers with this address becomes the first
# admin, and can never be demoted or deleted. Register it first after deploying.
# Every other admin or reviewer is invited from Admin -> Users.
# Once EMAIL_USER/EMAIL_PASS are set below, staff must also verify their email,
# so keep this an inbox you control.
ADMIN_EMAIL="you@example.com"

# Browser origins allowed to call the API, comma-separated. Defaults to the
# origin of FRONTEND_URL (or the local Vite dev server if that is unset).
# CORS_ORIGINS="https://studydome.example"

# How many reverse proxies sit in front of the API (1 for most hosts). Needed
# so rate limiting sees each visitor's real IP; without it every user behind the
# proxy shares one counter. Leave unset when the API is directly exposed.
# TRUST_PROXY=1

# Optional: requests per 15 minutes per IP across the whole API. The default
# (3000) is generous because a whole school can share one public IP.
# RATE_LIMIT_API_MAX=3000

# Used to build absolute links in emails and DPO payment redirects.
# Set these to your real deployed URLs in production.
FRONTEND_URL="http://localhost:5173"
BACKEND_URL="http://localhost:4000"

# --- Email (Gmail via Nodemailer) ---
# Leave both blank to keep the current dev-mode behavior (links shown
# on-screen instead of emailed). Fill in to send real emails:
#   1. Turn on 2-Step Verification: myaccount.google.com/security
#   2. Create an App Password: myaccount.google.com/apppasswords
#   3. Paste that 16-character password below (not your normal Gmail password)
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_FROM="Study Dome <you@gmail.com>"

# --- Payment (DPO Pay) ---
# Leave both blank to keep the manual "test unlock" button on /upgrade.
# Get these from your DPO merchant account (https://www.dpogroup.com):
# CompanyToken and the ServiceType configured for this product/currency.
DPO_COMPANY_TOKEN=""
DPO_SERVICE_TYPE=""
# Set to "true" while testing against DPO's sandbox environment.
DPO_SANDBOX="true"
