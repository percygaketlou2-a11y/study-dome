// Study Dome database schema.
// Using SQLite for zero-config local dev; swap provider to "postgresql"
// and set DATABASE_URL to a Postgres connection string for production.
//
// Mirrors the six-table reference model (Curricula, Levels, Subjects, Topics,
// PastPapers, Quizzes/Questions/Options), translated to Prisma conventions
// (cuid ids, camelCase fields) to stay consistent with the rest of this schema.

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                   String          @id @default(cuid())
  name                 String
  email                String          @unique
  passwordHash         String
  isAdmin              Boolean         @default(false)
  plan                 String          @default("free") // "free" | "premium" - manually toggled for now; swap in a real payment provider by changing what writes this field
  emailVerified         Boolean         @default(false)
  verifyTokenHash       String?
  verifyTokenExpiresAt  DateTime?
  resetTokenHash        String?
  resetTokenExpiresAt   DateTime?
  selectedCurriculumId String?
  selectedCurriculum   Curriculum?     @relation(fields: [selectedCurriculumId], references: [id])
  quizResults          QuizResult[]
  dailyActivity        DailyActivity[]
  createdAt            DateTime        @default(now())
}

model DailyActivity {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   String // "YYYY-MM-DD", one row per user per active day

  @@unique([userId, date])
}

model Curriculum {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  levels      Level[]
  subjects    Subject[]
  users       User[]
}

model Level {
  id           String     @id @default(cuid())
  curriculumId String
  curriculum   Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  name         String     // "Junior", "AS-Level", "A2-Level", "HL", "SL"...

  @@unique([curriculumId, name])
}

model Subject {
  id           String      @id @default(cuid())
  curriculumId String
  curriculum   Curriculum  @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  subjectCode  String?     // e.g. "0580" for IGCSE Maths
  name         String
  category     String?     // "STEM" | "Humanities" | "Languages" | "Commercial" | ...
  notes        String?     // admin-authored study notes; read-only for students
  topics       Topic[]
  quizzes      Quiz[]
  pastPapers   PastPaper[]

  @@unique([curriculumId, name])
}

model Topic {
  id            String   @id @default(cuid())
  subjectId     String
  subject       Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title         String
  sequenceOrder Int      @default(0)
  quizzes       Quiz[]
}

model Quiz {
  id                String       @id @default(cuid())
  subjectId         String
  subject           Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topicId           String?
  topic             Topic?       @relation(fields: [topicId], references: [id], onDelete: SetNull)
  title             String
  timeLimitMinutes  Int?
  totalMarks        Int
  isPremium         Boolean      @default(false)
  questions         Question[]
  results           QuizResult[]
}

model Question {
  id           String   @id @default(cuid())
  quizId       String
  quiz         Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questionText String
  questionType String   @default("multiple_choice") // "multiple_choice" | "short_answer" | "true_false"
  explanation  String?
  marks        Int      @default(1)
  order        Int      @default(0)
  options      Option[]
}

model Option {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionText String
  isCorrect  Boolean  @default(false)
}

model QuizResult {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  quizId         String
  quiz           Quiz     @relation(fields: [quizId], references: [id])
  score          Int      // percentage, 0-100
  marksAwarded   Int
  totalMarks     Int
  completedAt    DateTime @default(now())
}

model PastPaper {
  id                String   @id @default(cuid())
  subjectId         String
  subject           Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  year              Int
  season            String?  // "May/June" | "Oct/Nov" | ...
  paperNumber       Int
  variant           Int      @default(1)
  title             String?
  fileUrl           String
  markingSchemeUrl  String?
  isPremium         Boolean  @default(false)
  createdAt         DateTime @default(now())
}
